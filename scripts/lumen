#!/bin/sh
# Lumen launcher — UI by default, collector via "collect"
set -e
PREFIX="${LUMEN_PREFIX:-$HOME/.local}"
SHARE="${LUMEN_SHARE:-$PREFIX/share/lumen}"
SRC="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"

if [ -f "$SHARE/lumen_app.py" ]; then
  APP="$SHARE/lumen_app.py"
  WEB="$SHARE/web"
elif [ -f "$SRC/ui/lumen_app.py" ]; then
  APP="$SRC/ui/lumen_app.py"
  WEB="$SRC/ui/web"
else
  APP="/usr/local/share/lumen/lumen_app.py"
  WEB="/usr/local/share/lumen/web"
fi

cmd="${1:-}"
case "$cmd" in
  --version|-v|version)
    echo "Lumen 1.0.0"
    ;;
  --help|-h|help)
    cat <<'EOF'
Usage: lumen [COMMAND]

Commands:
  (none)              Launch the Lumen GTK 4 / libadwaita desktop app
  status, --status    Print the collector's live current.json snapshot
  collect, --collect  Run the lumen-collect background daemon directly
  version, --version  Print version information
  help, --help        Show this help message
EOF
    ;;
  collect|--collect)
    shift
    exec "${PREFIX}/bin/lumen-collect" "$@"
    ;;
  status|--status)
    DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/lumen"
    if [ -f "$DATA_DIR/current.json" ]; then
      cat "$DATA_DIR/current.json"
    else
      echo "collector has not written a snapshot yet"
    fi
    ;;
  *)
    export LUMEN_WEB="$WEB"
    exec python3 "$APP" "$@"
    ;;
esac
